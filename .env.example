# ─────────────────────────────────────────────────────────────────────────────
# Data Nexus Traffic — environment template.
# GENERATED by `npm run env:example` (scripts/generate-env-example.ts). Do not edit by hand.
#
# Server setup:  cp .env.example .env  → replace EVERY change-me value → bash scripts/preflight.sh
# Local stack:   same, but DB_APP_ROLE_MODE=separate + the localdb values → preflight.sh --localdb
# Generated secrets must be hex (openssl rand -hex 32) so they never need escaping inside URLs.
# NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (ADR 0002) ─────────────────────────────────────────────────────
# Production: the EXTERNAL company Postgres server 10.150.0.5 (PostgreSQL 18), database
# nexus_traffic, schema traffic — no postgres container (plain `docker compose up -d --build`).
# Local laptop / CI: `docker compose --profile localdb --profile local up -d --build` and the
# localdb values shown in each description below.
# Connection strings: postgres://<login>:<password>@<host>:<port>/<database>
# URL-ENCODE the password inside a URL: @ → %40, : → %3A, / → %2F, # → %23, % → %25
# (a raw @ in the password makes the host part wrong). Docker Compose also expands $ in .env
# values: write a literal $ as $$.
# NEVER commit real logins/passwords: they belong ONLY in the git-ignored .env on the host.
#
# How the api connects (read by migrate). One of:
#   owner    → production on the shared server, whose login cannot create roles: migrate creates
#              NO role; the api uses the SAME login, so DATABASE_URL = MIGRATION_DATABASE_URL.
#   separate → --profile localdb: migrate creates role nexus_app (DML only, grants re-applied on
#              every run) with NEXUS_APP_DB_PASSWORD; the api connects as nexus_app.
# Compose defaults to separate when this is empty.
DB_APP_ROLE_MODE=owner

# migrate connects with this OWNER login (it runs the DDL).
#   owner mode (production): the shared login, e.g. …@10.150.0.5:5432/nexus_traffic
#   localdb: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
MIGRATION_DATABASE_URL=postgres://change-me-login:change-me-url-encoded-password@change-me-host:5432/change-me-database

# The api connects with this login.
#   owner mode: MUST be IDENTICAL to MIGRATION_DATABASE_URL (preflight.sh checks it).
#   separate mode: postgres://nexus_app:<NEXUS_APP_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=postgres://change-me-login:change-me-url-encoded-password@change-me-host:5432/change-me-database

# ONLY for DB_APP_ROLE_MODE=separate (leave empty in owner mode): the password migrate sets on
# role nexus_app on EVERY run (rotate = change it + DATABASE_URL, redeploy). Hex: openssl rand -hex 32.
NEXUS_APP_DB_PASSWORD=

# What pg-backup dumps nightly. Empty = MIGRATION_DATABASE_URL (the usual choice).
BACKUP_DATABASE_URL=

# api connections for ingest/admin writes.
PG_POOL_WRITE_MAX=4

# api connections for dashboard reads.
PG_POOL_QUERY_MAX=6

# ─── Local Postgres container (ONLY for --profile localdb) ───────────────────
# Read only by the postgres service of profile localdb (and its first-start initdb).
# Production on the external server ignores them (preflight.sh checks them only with --localdb).
#
# Image for the localdb postgres AND pg-backup. pg_dump must be >= the server major (18).
PG_IMAGE=postgres:18-alpine

# Database OWNER role of the local container (ONLY for --profile localdb).
POSTGRES_USER=nexus_owner

# Owner password (ONLY for --profile localdb). Hex only: openssl rand -hex 32.
POSTGRES_PASSWORD="change-me-<openssl rand -hex 32>"

# Database name of the local container (ONLY for --profile localdb).
POSTGRES_DB=nexus_traffic

# ─── SSO (shared with the portal) ────────────────────────────────────────────
# The portal's JWT secret; verifies the access_token cookie. Runtime only, NEVER a build arg.
LIBAS_JWT_SECRET="change-me-<the portal JWT_SECRET_KEY>"

# Where the dashboard sends signed-out users (used by the web container from S2).
PORTAL_LOGIN_URL=https://nexus.libas.in/login

# Query parameter carrying the return URL (used by the web container from S2).
PORTAL_RETURN_PARAM=return

# Public origin, used for absolute links (docs, redirects).
PUBLIC_ORIGIN=https://nexus.libas.in

# Public URL prefix. Leave /traffic unless the gateway changes.
PUBLIC_BASE_PATH=/traffic

# ─── Dashboard access ────────────────────────────────────────────────────────
# Comma-separated allowlist. If set, ONLY these (+ admins) may open the dashboard.
DASHBOARD_ALLOWED_EMAILS=

# Used only when DASHBOARD_ALLOWED_EMAILS is empty.
DASHBOARD_ALLOWED_DOMAINS=libas.in

# Admins manage apps/keys and see IP addresses. Put at least one email here.
DASHBOARD_ADMIN_EMAILS=

# ─── Secrets (hex only: openssl rand -hex 32) ────────────────────────────────
# HMAC pepper for API key hashes. Changing it invalidates EVERY issued key.
API_KEY_PEPPER="change-me-<openssl rand -hex 32>"

# HMAC secret for opaque user ids in URLs. Changing it re-keys user links.
USER_KEY_SECRET="change-me-<openssl rand -hex 32>"

# HMAC secret for ip_hash.
IP_HASH_SECRET="change-me-<openssl rand -hex 32>"

# ─── Privacy and retention ───────────────────────────────────────────────────
# full | truncated | hashed. Geo is always resolved from the full IP first.
IP_STORAGE_MODE=full

# Months of raw events kept; older monthly partitions are dropped nightly.
RAW_RETENTION_MONTHS=6

# ─── Network and ingest ──────────────────────────────────────────────────────
# Proxies in front of the api (gateway nginx = 1). Never applies to the body `ip`.
TRUST_PROXY_HOPS=1

# Extra browser origins allowed outside production (comma-separated).
CORS_DEV_ORIGINS=

# Server-ingest requests per key per minute.
INGEST_RATE_LIMIT_SERVER_PER_MIN=600

# Browser beacons per session per minute.
INGEST_RATE_LIMIT_BROWSER_PER_SESSION_PER_MIN=60

# Failed key authentications allowed per IP per minute.
INGEST_IP_FAILURE_PER_MIN=60

# ─── Docs and logging ────────────────────────────────────────────────────────
# Who other teams contact for keys (rendered into the public guide).
DOCS_CONTACT="the Data Nexus team"

# debug | info | warn | error.
LOG_LEVEL=info

# ─── Web (used by the web container from S2) ─────────────────────────────────
# Socket.io path the browser uses (build arg of the web image).
NEXT_PUBLIC_SOCKET_PATH=/traffic/socket.io

# Rewrite target for `next dev` only.
API_INTERNAL_URL=http://localhost:4000

# ─── Set by the Docker image (keep commented when using Docker) ──────────────
# production in the image; development when unset.
# NODE_ENV=development

# Port inside the container (compose maps 127.0.0.1:4005 → 4000).
# PORT=4000

# Built docs directory; defaults to <repo>/docs/dist (/app/docs/dist in the image).
# DOCS_DIR=/app/docs/dist
